# Public defaults, committed. Vite loads this file, then .env.local on top of it —
# per-machine overrides and anything secret go there, and .gitignore keeps that one out.

# The API base musicrain talks to, read through $env/static/public in src/lib/discord.ts.
# Inside a Discord Activity it is ignored: the CSP only allows the /.proxy mappings.
PUBLIC_API_URL=https://api.example.com/Audio

# Where the app itself is served and installed from. A friend link has to point here for an
# installed app to open it; inside the Discord activity `location` is Discord's, so the link
# is built from this instead (src/state/friends.svelte.ts).
PUBLIC_SITE_URL=https://music.example.com
VITE_DISCORD_CLIENT_ID=0000000000000000000
