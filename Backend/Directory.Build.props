<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The solution builds clean at this level. A rule that cannot be satisfied is suppressed at the type
         that trips it, with the reason, rather than switched off here. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- A new advisory against a package still shows as a warning, but it must not stop an image build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- ReSharper cannot see through JSON serialization, Discord command dispatch or IConfiguration
       binding, so the types those reach carry [UsedImplicitly]. One reference for every project. -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations"/>
  </ItemGroup>

</Project>
