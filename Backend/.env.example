# Copy to .env and fill in. docker compose reads .env automatically; .gitignore keeps it out of git.
# Every value below is the default from compose.yaml unless marked otherwise.

# ── Spotify (gaida-spotify) ────────────────────────────────────────────────────
# No credentials: the pod runs on SpotAPI, which needs no client ID and no secret.
# Search hits per query. Each one costs Gaida.API a lookup against the library or YouTube.
SPOTIFY_SEARCH_LIMIT=15

# ── Deezer (gaida-deezer) ──────────────────────────────────────────────────────
# The account cookie the pod downloads with. Without it the pod is metadata only: search, resolve and
# playlist still answer, /content does not, and DEEZER_RESOLVE below has to stay true. How to find it:
#   https://github.com/nathom/streamrip/wiki/Finding-Your-Deezer-ARL-Cookie
DEEZER_ARL=
# The one knob to turn once DEEZER_ARL is set: false makes Deezer results play from Deezer. Left true,
# they are looked up again against the library or YouTube, exactly like Spotify's — which is what a
# checkout with no ARL needs, and why that is the default.
DEEZER_RESOLVE=true
DEEZER_SEARCH_LIMIT=15
# How much of a pasted playlist to read. Deezer will hand over all of an editorial playlist's
# thousands of tracks; nobody queues that on purpose, and every entry costs the client a row.
DEEZER_PLAYLIST_LIMIT=1000
# Downloaded songs. A real cache: losing it costs re-downloads and nothing else — tracks promoted into
# the library live under MUSIC_LIBRARY_PATH instead.
DEEZER_CACHE_PATH=./data/deezer-audio
# Disk budget, sized against free space on the path above. Roughly 2000 tracks at MP3 320, or 500 at
# FLAC; the oldest go first when it is reached.
DEEZER_CACHE_MAX_BYTES=21474836480
# How many cached tracks Oko's Deezer table carries. Oko polls the snapshot every two seconds while
# that panel is open, so this is a payload budget, not a page size — the filter box searches only what
# was sent. 0 lifts the cap and sends every cached track, which is fine for a few hundred of them.
DEEZER_ADMIN_ROWS=200

# ── The library (gaida-local) ──────────────────────────────────────────────────
# Mounted read-write: Info.json is rewritten in place.
MUSIC_LIBRARY_PATH=./data/music
ALBUM_COVERS_PATH=./data/covers
# Needs the scheme — it becomes an absolute cover URL.
PUBLIC_DOMAIN=http://localhost
# The uid:gid gaida-local runs as, so imported tracks and rewritten Info.json belong to
# the host user that owns MUSIC_LIBRARY_PATH instead of root. Fill in `id -u` and `id -g`.
LIBRARY_UID=1000
LIBRARY_GID=1000

# ── YouTube caches (gaida-youtube) ─────────────────────────────────────────────
# Repointing the audio cache starts empty and re-downloads everything.
YOUTUBE_CACHE_DB_PATH=./data/youtube-cache
YOUTUBE_AUDIO_CACHE_PATH=./data/youtube-audio

# ── Gaida.API ──────────────────────────────────────────────────────────────────
# Absolute and public: every contentUrl is built from it.
PUBLIC_API_BASE_URL=http://localhost:5340
YOUTUBE_RANDOM_SHARE=0.4
RESOLVE_CONCURRENCY=4

# ── Dunav ──────────────────────────────────────────────────────────────────────
DUNAV_RETENTION_MINUTES=45
# Disk budget, sized against free space on /.
DUNAV_MAX_BYTES=21474836480
DUNAV_MEMORY_LIMIT=1g

# ── Memory ceilings ────────────────────────────────────────────────────────────
# Every pod runs under mem_limit AND memswap_limit, both set to the value below. Leaving swap out is
# what makes a leak a frozen desktop rather than one dead container: the pod swaps its way through
# gigabytes and takes the host's page cache with it. With both set, a runaway is OOM-killed inside
# its own cgroup, named in `dmesg`, and restarted by `restart: unless-stopped`.
# Pods idle at 25-165 MB, so this is a runaway detector rather than a budget.
SERVICE_MEMORY_LIMIT=2g
# The bot has its own, being the one that has actually run away (16 GB, 2026-09-18).
BOT_MEMORY_LIMIT=2g

# ── Host ports ─────────────────────────────────────────────────────────────────
# Bound to 127.0.0.1; nginx faces the world.
GAIDA_API_PORT=5340
DUNAV_PORT=5341
SELO_PORT=5342
DOM_PORT=5343

# ── Admin panel (oko) ──────────────────────────────────────────────────────────
# Oko refuses to start while either is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# How Oko proves itself to every service's /Admin routes. Generate one:
#   openssl rand -hex 32
# Unset, /Admin is disabled everywhere and Oko shows every target as down.
ADMIN_TOKEN=
# Published on every interface, unlike the ports above — the host firewall gates it.
# Basic auth sends its password unencrypted, so front it with TLS on an untrusted network.
OKO_PORT=5344
